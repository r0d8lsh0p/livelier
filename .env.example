# Livelier bridge — local configuration. Global (core) vars first, then one
# prefixed block per source network (OWNCAST_*).

# The single, local, isolated relay. should be local (ws://localhost, ws://127.0.0.1,
# or a compose service named *relay*). No public relay is ever allowed.
LOCAL_RELAY_URL=ws://localhost:7449

# Two-relay routing (both default to LOCAL_RELAY_URL when unset).
# EVENT_RELAY_URL: durable discovery events — 30311s + bridge/instance kind-0s
#   (the SW2 "only we publish" relay).
# CHAT_RELAY_URL: chat-session events — bridged 1311s + ephemeral chatter
#   identities (the strict TTL relay); the firehose and /demand live here.
# EVENT_RELAY_URL=ws://localhost:7449
# CHAT_RELAY_URL=ws://localhost:7450

# Postgres for instance state.
DATABASE_URL=postgres://bridges:bridges@localhost:5544/bridges

# Secret for deterministic per-instance key derivation. Generate a random value;
# rotating it re-keys every bridged identity. NEVER commit a real secret.
BRIDGE_KEY_SECRET=change-me-to-a-random-secret

# Bridge identity (author of every 30311 + the bridge kind-0). Generate with
# `nak key generate | nak encode nsec`. When unset, falls back to a key derived
# from BRIDGE_KEY_SECRET. NEVER commit a real nsec.
BRIDGE_NSEC=

# Public-facing bridge name (Livelier, livelier.live). Used as the bridge
# kind-0 name and the `client` tag on every event.
BRIDGE_NAME=Livelier

# ── Owncast source block ────────────────────────────────────────────────────
# Master gate for the source (default true) and for its discovery loop alone.
# OWNCAST_ENABLED=true
# OWNCAST_DISCOVERY_ENABLED=true

# Directory feed (default shown).
OWNCAST_DIRECTORY_URL=https://owncast.directory/api/home

# Cadence / policy (defaults shown). NSFW is NOT filtered — the instance's
# self-declared flag becomes a NIP-36 content-warning tag on the 30311.
OWNCAST_POLL_INTERVAL_MS=60000
OWNCAST_REPUBLISH_INTERVAL_MS=900000
OWNCAST_SNAPSHOT_INTERVAL_MS=3600000
OWNCAST_HLS_TIMEOUT_MS=10000
OWNCAST_MAX_CONSECUTIVE_FAILURES=3

# Chat gates (both default false). Chat only connects to rows with
# chat_enabled=true (per-instance allowlist).
OWNCAST_CHAT_TO_NOSTR=false
OWNCAST_CHAT_FROM_NOSTR=false

# Default posture stamped onto NEWLY discovered rows (inside the INSERT).
# Existing rows are never auto-swept to match — explicit per-row settings
# (opt-outs, test enables) always stick; posture changes for existing rows
# are a scripted operator backfill. discovery_enabled=false stops publishes
# and probes for that instance; already-published events stay on the relays
# (removal = operations/retract-instance.mjs, a manual operator action).
OWNCAST_DEFAULT_DISCOVERY_ENABLED=true
OWNCAST_DEFAULT_CHAT_ENABLED=false

# NIP-40 lifetime (seconds) stamped on every bridged 1311 (default 3 hours,
# matching the strict relay's TTL). Bridged chatters never opted into Nostr,
# so their mirrored messages must expire.
CHAT_EXPIRATION_SECONDS=10800

# Demand-based connection (ephemeral-relay GET /demand). When DEMAND_URL is
# set, a room's Owncast chat websocket opens only once a Nostr viewer
# subscription names its #a (establish-only; never torn down while the room
# lives). Unset = connect eagerly. Token = the relay's AUTH_TOKEN, if gated.
# DEMAND_URL=http://localhost:7450/demand
# DEMAND_AUTH_TOKEN=
# DEMAND_POLL_INTERVAL_MS=10000

# ── Network relays: reads free, writes gated ───────────────────────────────
# Profile READS have no flag — inbound chatter names always resolve through
# the shared profile stack's full network coverage (a REQ has no footprint).
#
# NETWORK_PROFILE_PUBLISH_ENABLED is the WRITE gate (default off): on, all
# bridge kind-0/10002s also publish to the profile-write set (purplepag.es).
# ⚠ ONLY ONE ENVIRONMENT MAY EVER HOLD THIS FLAG (prod, at launch). Every
# environment derives different keys for the same channels, so a second
# publishing environment mints duplicate identities the network keeps
# forever. The boot log warns loudly when set.
#
# NETWORK_CHAT_READ_ENABLED (default off) activates the network chat
# firehose — a product-rollout gate, not a containment one.
#
# WHICH relays is not an env decision: the sets are curated in code
# (src/core/relays.ts) where changes get review, tests, and history.
# The two list vars below are a TEST-HARNESS escape hatch only: they override
# the code sets so e2e WRITE paths point at LOCAL dummy relays. Never set
# them in a real deployment; never point test writes at public relays.
# NETWORK_PROFILE_PUBLISH_ENABLED=false
# NETWORK_CHAT_READ_ENABLED=false
# NETWORK_PROFILE_WRITE_RELAYS=ws://localhost:7460
# NETWORK_CHAT_READ_RELAYS=ws://localhost:7461,ws://localhost:7462

LOG_LEVEL=info

# Directory for the persistent profile caches (Node fs storage adapter).
# Default: .data/ in the working directory.
# STORAGE_DIR=.data

# Set to true to stop merging the default read relays into explicitly
# provided relay lists (profile reads then use only what callers pass).
# NOSTR_RELAYS_DISABLE_DEFAULTS=false
